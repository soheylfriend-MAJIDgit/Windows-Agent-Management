# PostgreSQL (Vercel Prisma Postgres or Neon integration)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Direct, non-pooled URL used only by migrations. If the provider gives one URL, repeat DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Vercel Blob: BLOB_STORE_ID/OIDC در Vercel خودکار است.
# فقط برای اجرای محلی خارج از Vercel، token قدیمی اختیاری است:
BLOB_READ_WRITE_TOKEN=""

# Manager authentication — optional; leave blank for an open site
MANAGER_PASSCODE=""
AUTH_SECRET=""

# GitHub server token, never NEXT_PUBLIC_*
GITHUB_TOKEN=""
COLLAB_OWNER="soheylfriend-MAJIDgit"
COLLAB_REPO="Windows-Agent"
COLLAB_BRANCH="main"
MOTHER_OWNER="soheylfriend-MAJIDgit"
MOTHER_REPO="Windows-Agent"
MOTHER_BRANCH="main"
