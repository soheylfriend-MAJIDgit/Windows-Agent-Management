{
  "name": "windows-agent-management",
  "version": "1.0.0",
  "private": true,
  "description": "ایجنت مدیریت پنل ویندوز — داشبورد نظارت، اجرای دوباره و ارسال پرامپت برای ایجنت همکار",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "typecheck": "tsc --noEmit",
    "lint:job": "python3 scripts/lint_job.py",
    "db:import:d1": "node scripts/import_legacy_json.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.2",
    "fflate": "0.8.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
